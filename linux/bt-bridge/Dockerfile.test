FROM python@sha256:d764629ce0ddd8c71fd371e9901efb324a95789d2315a47db7e4d27e78f1b0e9
RUN apt-get update && apt-get install -y --no-install-recommends dbus-daemon \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /project
COPY linux/bt-bridge/requirements.txt /project/requirements.txt
RUN python -m venv /opt/bridge-venv \
    && /opt/bridge-venv/bin/pip install --no-cache-dir -r requirements.txt
COPY linux /project/linux
COPY tests/bluetooth /project/tests/bluetooth
CMD ["/opt/bridge-venv/bin/python", "-m", "unittest", "discover", "-s", "tests/bluetooth", "-v"]
